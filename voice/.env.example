# ===========================================
# Fahamika Voice Pipeline — Environment Config
# ===========================================
# Copy this to .env and fill in your keys.
# NEVER commit .env to git.

# App
APP_ENV=development
VOICE_WEBHOOK_PORT=8000
VOICE_WEBHOOK_HOST=0.0.0.0

# DeepSeek API (LLM — simplification/translation)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# LLM Provider — "deepseek" (cloud) or "ollama" (local VPS)
LLM_PROVIDER=deepseek

# Ollama (local LLM — fallback when on VPS)
# Uncomment and use instead of DeepSeek when running on the droplet:
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:1b

# Whisper (Speech-to-Text)
WHISPER_MODEL_SIZE=base
# Options: tiny, base, small, medium, large-v3

# Pinecone (Vector Database — content retrieval)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=fahamika-content
PINECONE_ENVIRONMENT=us-east-1

# Embedding model (local HuggingFace model — no API key needed)
# Options: intfloat/multilingual-e5-small, intfloat/multilingual-e5-base, BAAI/bge-m3
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Africa's Talking (Voice API — production only)
# AT_VOICE_API_KEY=your-at-api-key
# AT_VOICE_USERNAME=sandbox

# TTS (Text-to-Speech)
# Providers: piper, sauti, google-cloud, intron-sahara
TTS_PROVIDER=sauti
SAUTI_API_URL=https://msingi-ai--sauti-inference-inferenceapi-asgi-app.modal.run/v1/synthesize
SAUTI_SPEAKER=1
# TTS_MODEL_PATH=voice/models/
# GOOGLE_TTS_CREDENTIALS=path/to/service-account.json
